<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Item</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-black via-gray-900 to-black">
  
  <!-- Form Container -->
  <div class="w-full max-w-sm backdrop-blur-xl bg-gray-900/70 border border-gray-700 shadow-2xl rounded-2xl pt-6 pb-6 transform hover:scale-[1.01] transition duration-300">
    <div class="rounded-xl p-6 space-y-5">
      
      <!-- Header -->
      <div class="text-center space-y-3">
        <div class="mx-auto w-12 h-12 bg-gradient-to-tr from-blue-600 to-purple-600 shadow-lg shadow-blue-900/40 rounded-xl flex items-center justify-center text-lg text-white">
          ✏️
        </div>
        <h1 class="text-2xl font-bold text-white tracking-wide">Edit Item</h1>
        <p class="text-gray-400 text-sm">Update your listing details below</p>
      </div>
      
      <!-- Edit Item Form -->
      <form action="/books/edit/<%= book.id %>" method="POST" class="space-y-4">
        
        <!-- Title Field -->
        <div class="space-y-1">
          <label for="title" class="block text-xs font-semibold text-gray-300">Item Title</label>
          <input 
            type="text" 
            name="title" 
            id="title"
            class="w-full px-3 py-2 bg-gray-800/60 border border-gray-600 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-600 transition text-sm" 
            value="<%= book.title %>"
            required
          >
        </div>

        <!-- Category Field -->
        <div class="space-y-1">
          <label for="category" class="block text-xs font-semibold text-gray-300">Category</label>
          <select 
            name="category" 
            id="category" 
            class="w-full px-3 py-2 bg-gray-800/60 border border-gray-600 rounded-xl text-white focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-600 transition text-sm" 
            required
          >
            <option value="" disabled class="bg-gray-900">-- Select Category --</option>
            <option value="books" <%= book.category === 'books' ? 'selected' : '' %>>Books</option>
            <option value="electronics" <%= book.category === 'electronics' ? 'selected' : '' %>>Electronics</option>
            <option value="drg_assignments" <%= book.category === 'drg_assignments' ? 'selected' : '' %>>DRG & Assignments</option>
            <option value="artworks" <%= book.category === 'artworks' ? 'selected' : '' %>>Artworks</option>
            <option value="thrifting" <%= book.category === 'thrifting' ? 'selected' : '' %>>Thrifting</option>
            <option value="other" <%= book.category === 'other' ? 'selected' : '' %>>Other Items</option>
          </select>
        </div>

        <!-- Extra Info Field -->
        <div class="space-y-1">
          <label for="extraInfo" id="extraInfoLabel" class="block text-xs font-semibold text-gray-300">Additional Info</label>
          <input 
            type="text" 
            name="extraInfo" 
            id="extraInfo" 
            class="w-full px-3 py-2 bg-gray-800/60 border border-gray-600 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-600 transition text-sm" 
            value="<%= book.extraInfo || book.author || '' %>"
            placeholder="Additional information"
          >
        </div>

        <!-- Description Field -->
        <div class="space-y-1">
          <label for="description" class="block text-xs font-semibold text-gray-300">Description</label>
          <textarea 
            name="description" 
            id="description"
            class="w-full px-3 py-2 bg-gray-800/60 border border-gray-600 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-600 transition text-sm resize-y" 
            rows="2"
            required
          ><%= book.description %></textarea>
        </div>

        <!-- Price Field -->
        <div class="space-y-1">
          <label for="price" class="block text-xs font-semibold text-gray-300">Price (₹)</label>
          <input 
            type="number" 
            name="price" 
            id="price"
            class="w-full px-3 py-2 bg-gray-800/60 border border-gray-600 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-600 transition text-sm" 
            value="<%= book.price %>"
            required
          >
        </div>

        <!-- Rent Per Day Field -->
        <div class="space-y-1">
          <label for="rent_per_day" class="block text-xs font-semibold text-gray-300">Rent per day (₹)</label>
          <input 
            type="number" 
            name="rent_per_day" 
            id="rent_per_day"
            class="w-full px-3 py-2 bg-gray-800/60 border border-gray-600 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-600 transition text-sm" 
            value="<%= book.rent_per_day || '' %>"
            step="0.01" 
            min="0"
          >
        </div>

        <!-- Image URL Field -->
        <div class="space-y-1">
          <label for="image_url" class="block text-xs font-semibold text-gray-300">Image URL</label>
          <input 
            type="url" 
            name="image_url" 
            id="image_url"
            class="w-full px-3 py-2 bg-gray-800/60 border border-gray-600 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-600 transition text-sm" 
            value="<%= book.image_url || '' %>"
          >
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          class="w-full py-2 px-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 shadow-lg shadow-purple-900/40 transition duration-300"
        >
          Update Item
        </button>
      </form>

      <!-- Back Link -->
      <div class="text-center pt-2">
        <a 
          href="/books/dashboard" 
          class="text-blue-400 hover:text-blue-300 font-medium transition-colors duration-200 hover:underline"
        >
          ← Back to Dashboard
        </a>
      </div>
    </div>
  </div>

  <script>
    const categorySelect = document.getElementById('category');
    const extraInfoInput = document.getElementById('extraInfo');
    const extraInfoLabel = document.getElementById('extraInfoLabel');

    function updateExtraInfoField() {
      let placeholder = 'Additional information';
      let label = 'Additional Info';

      switch(categorySelect.value) {
        case 'books': placeholder = 'Author Name'; label = 'Author'; break;
        case 'electronics': placeholder = 'Brand Name'; label = 'Brand'; break;
        case 'drg_assignments': placeholder = 'Wingman Info'; label = 'Wingman'; break;
        case 'artworks': placeholder = 'Artist Name'; label = 'Artist'; break;
        case 'thrifting': placeholder = 'Size (e.g. M, L, 10, 32)'; label = 'Size'; break;
      }
      extraInfoInput.placeholder = placeholder;
      extraInfoLabel.textContent = label;
    }

    categorySelect.addEventListener('change', updateExtraInfoField);
    updateExtraInfoField();
  </script>
</body>
</html>
