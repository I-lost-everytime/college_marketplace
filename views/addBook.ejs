<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Add Item</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex items-center justify-center p-4 bg-black">
  
  <!-- Form Container -->
  <div class="w-full max-w-sm border border-gray-700 pt-6 pb-6 rounded-2xl bg-gray-900">
    <div class="rounded-xl p-6 space-y-4">
      
      <!-- Header -->
      <div class="text-center space-y-2">
      
        <h1 class="text-xl font-bold text-white">Add Item</h1>
      </div>
      
      <!-- Add Item Form -->
      <form action="/books/add" method="POST" class="space-y-3">
        
        <!-- Title Field -->
        <div class="space-y-1">
          <label for="title" class="block text-xs font-medium text-gray-300">Item Title</label>
          <input 
            type="text" 
            name="title" 
            id="title"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-600 rounded-full text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors duration-200 text-sm" 
            placeholder="Enter item title" 
            required
          >
        </div>

        <!-- Category Field -->
        <div class="space-y-1">
          <label for="category" class="block text-xs font-medium text-gray-300">Category</label>
          <select 
            name="category" 
            id="category" 
            class="w-full px-3 py-2 bg-gray-800 border border-gray-600 rounded-full text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors duration-200 appearance-none cursor-pointer text-sm" 
            required
          >
            <option value="" class="bg-gray-800">-- Select Category --</option>
            <option value="Books" class="bg-gray-800">Books</option>
            <option value="electronics" class="bg-gray-800">Electronics</option>
            <option value="drg_assignments" class="bg-gray-800">DRG & Assignments</option>
            <option value="artworks" class="bg-gray-800">Artworks</option>
            <option value="thrifting" class="bg-gray-800">Thrifting</option>
            <option value="other" class="bg-gray-800">Other Items</option>
          </select>
        </div>

        <!-- Extra Info Field -->
        <div class="space-y-1">
          <label for="extraInfo" class="block text-xs font-medium text-gray-300">Additional Info</label>
          <input 
            type="text" 
            name="extraInfo" 
            id="extraInfo" 
            class="w-full px-3 py-2 bg-gray-800 border border-gray-600 rounded-full text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors duration-200 text-sm" 
            placeholder="Additional information"
          >
        </div>

        <!-- Price Field -->
        <div class="space-y-1">
          <label for="price" class="block text-xs font-medium text-gray-300">Price (₹)</label>
          <input 
            type="number" 
            name="price" 
            id="price"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-600 rounded-full text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors duration-200 text-sm" 
            placeholder="Enter price" 
            required
          >
        </div>

        <!-- Rent Per Day Field -->
        <div class="space-y-1">
          <label for="rent_per_day" class="block text-xs font-medium text-gray-300">Rent per day (₹) - Optional</label>
          <input 
            type="number" 
            name="rent_per_day" 
            id="rent_per_day"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-600 rounded-full text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors duration-200 text-sm" 
            placeholder="Daily rent amount" 
            step="0.01" 
            min="0"
          >
        </div>

        <!-- Description Field -->
        <div class="space-y-1">
          <label for="description" class="block text-xs font-medium text-gray-300">Description</label>
          <textarea 
            name="description" 
            id="description"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-600 rounded-xl text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors duration-200 resize-y text-sm" 
            placeholder="Describe your item" 
            rows="2"
          ></textarea>
        </div>

        <!-- Image URL Field -->
        <div class="space-y-1">
          <label for="image_url" class="block text-xs font-medium text-gray-300">Image URL - Optional</label>
          <input 
            type="text" 
            name="image_url" 
            id="image_url"
            class="w-full px-3 py-2 bg-gray-800 border border-gray-600 rounded-full text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors duration-200 text-sm" 
            placeholder="Image URL"
          >
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          class="w-full py-2 px-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors duration-200 text-sm"
        >
          Add Item
        </button>
      </form>

      <!-- Back Link -->
      <div class="text-center">
        <a 
          href="/books/dashboard" 
          class="text-blue-400 hover:text-blue-300 font-medium transition-colors duration-200 hover:underline"
        >
          ← Back to Dashboard
        </a>
      </div>
    </div>
  </div>

  <script>
    const categorySelect = document.getElementById('category');
    const extraInfoInput = document.getElementById('extraInfo');

    function updateExtraInfoPlaceholder() {
      switch (categorySelect.value) {
        case 'Books':
          extraInfoInput.placeholder = 'Author Name';
          break;
        case 'electronics':
          extraInfoInput.placeholder = 'Brand Name';
          break;
        case 'drg_assignments':
          extraInfoInput.placeholder = 'Wingman info';
          break;
        case 'artworks':
          extraInfoInput.placeholder = 'Artist Name';
          break;
        case 'thrifting':
          extraInfoInput.placeholder = 'Size (e.g. M, L, 10, 32)';
          break;
        case 'other':
          extraInfoInput.placeholder = 'Additional info';
          break;
        default:
          extraInfoInput.placeholder = 'Additional information';
          break;
      }
    }

    categorySelect.addEventListener('change', updateExtraInfoPlaceholder);
  </script>
</body>
</html>