<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Add Book</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: #0d0d0d;
      color: #ffffff;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2rem;
      font-family: 'Segoe UI', sans-serif;
    }

    .form-container {
      background: #1a1a1a;
      padding: 2rem;
      border-radius: 16px;
      box-shadow: 0 0 15px rgba(255, 0, 255, 0.3);
      max-width: 500px;
      width: 100%;
    }

    .form-control,
    .form-control:focus {
      background-color: #2c2c2c;
      color: white;
      border: 1px solid #555;
      box-shadow: none;
    }

    .form-control::placeholder {
      color: #bbb;
    }

    .btn-glow {
      background: linear-gradient(45deg, #7f00ff, #e100ff);
      color: white;
      border: none;
      width: 100%;
      padding: 0.75rem;
      border-radius: 8px;
      transition: 0.3s ease;
      box-shadow: 0 0 8px #e100ff50;
    }

    .btn-glow:hover {
      transform: scale(1.05);
      box-shadow: 0 0 15px #e100ffaa;
    }

    a.back-link {
      color: #ccc;
      display: inline-block;
      margin-top: 1rem;
      text-align: center;
      width: 100%;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    a.back-link:hover {
      color: #e100ff;
    }
  </style>
</head>
<body>
  <div class="form-container">
    <h2 class="text-center mb-4">📚 Add a Book</h2>
    <form action="/books/add" method="POST">
      <div class="mb-3">
        <input type="text" name="title" class="form-control" placeholder="Title" required>
      </div>

      <div class="mb-3">
        <select name="category" id="category" class="form-select" required>
          <option value="">-- Select Category --</option>
          <option value="Books">Books</option>
          <option value="electronics">Electronics</option>
          <option value="drg_assignments">DRG & Assignments</option>
          <option value="artworks">Artworks</option>
          <option value="thrifting">Thrifting</option>
          <option value="other">Other Items</option>
        </select>
      </div>

      <div class="mb-3">
        <input type="text" name="extraInfo" id="extraInfo" class="form-control" placeholder="Author (or relevant info)">
      </div>

      <div class="mb-3">
        <input type="number" name="price" class="form-control" placeholder="Price (₹)" required>
      </div>

      <div class="mb-3">
        <input type="number" name="rent_per_day" class="form-control" placeholder="Rent per day (₹) — optional" step="0.01" min="0">
      </div>

      <div class="mb-3">
        <textarea name="description" class="form-control" placeholder="Description" rows="3"></textarea>
      </div>

      <div class="mb-3">
        <input type="text" name="image_url" class="form-control" placeholder="Image URL (optional)">
      </div>

      <button type="submit" class="btn-glow">Add Book</button>
    </form>
    <a href="/books/dashboard" class="back-link">← Back to Dashboard</a>
  </div>

  <script>
    const categorySelect = document.getElementById('category');
    const extraInfoInput = document.getElementById('extraInfo');

    function updateExtraInfoPlaceholder() {
      switch (categorySelect.value) {
        case 'books':
          extraInfoInput.placeholder = 'Author Name';
          break;
        case 'electronics':
          extraInfoInput.placeholder = 'Brand Name';
          break;
        case 'drg_assignments':
          extraInfoInput.placeholder = 'Wingman info';
          break;
        case 'artworks':
          extraInfoInput.placeholder = 'Artist Name';
          break;
        case 'thrifting':
          extraInfoInput.placeholder = 'Size (e.g. M, L, 10, 32)';
          break;
        case 'other':
          extraInfoInput.placeholder = 'Additional info';
          break;
        default:
          extraInfoInput.placeholder = 'Author (or relevant info)';
          break;
      }
    }

    categorySelect.addEventListener('change', updateExtraInfoPlaceholder);
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
