<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register - Book Marketplace</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: radial-gradient(circle at top left, #0d1117, #0a0a0a);
      color: #e6f1ff;
      font-family: 'Segoe UI', sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1rem;
    }

    .register-box {
      background-color: #1a1a2e;
      padding: 2.5rem;
      border-radius: 20px;
      max-width: 420px;
      width: 100%;
      box-shadow: 0 0 25px rgba(0, 229, 255, 0.1);
      border: 2px solid transparent;
      transition: 0.4s ease;
    }

    .register-box:hover {
      box-shadow: 0 0 35px #00e5ff88;
      border-color: #00e5ff;
      transform: scale(1.01);
    }

    .register-box h2 {
      color: #00e5ff;
      text-shadow: 0 0 10px #00e5ff88;
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .form-control {
      background-color: #2c2f3a;
      border: 1px solid #444;
      color: #e6f1ff;
      transition: 0.3s;
    }

    .form-control:focus {
      border-color: #00e5ff;
      box-shadow: 0 0 10px rgba(0, 229, 255, 0.5);
      background-color: #2c2f3a;
      color: #fff;
    }

    .form-control::placeholder {
      color: #aaa;
    }

    .btn-glow {
      background: linear-gradient(45deg, #00e5ff, #00bfff);
      color: #000;
      font-weight: 600;
      border: none;
      border-radius: 10px;
      padding: 0.6rem;
      transition: all 0.3s ease;
      box-shadow: 0 0 10px rgba(0, 229, 255, 0.4);
    }

    .btn-glow:hover {
      background: linear-gradient(45deg, #00c4cc, #00aaff);
      box-shadow: 0 0 18px rgba(0, 229, 255, 0.7);
      transform: scale(1.03);
    }

    .btn-google {
      background-color: #db4437;
      color: white;
      font-weight: 600;
      border: none;
      border-radius: 10px;
      padding: 0.6rem;
      transition: all 0.3s ease;
      box-shadow: 0 0 10px rgba(219, 68, 55, 0.4);
    }

    .btn-google:hover {
      background-color: #c23321;
      box-shadow: 0 0 18px rgba(219, 68, 55, 0.7);
      transform: scale(1.03);
    }

    .link-glow {
      color: #00e5ff;
      transition: 0.2s ease;
    }

    .link-glow:hover {
      color: #80faff;
      text-decoration: underline;
    }

    .alert-danger {
      background-color: #ff4c4c;
      color: #fff;
      border: none;
      box-shadow: 0 0 12px rgba(255, 76, 76, 0.5);
    }

    .text-small {
      font-size: 0.9rem;
    }

    .floating {
      animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    .google-icon {
      width: 20px;
      margin-right: 8px;
      vertical-align: middle;
    }
  </style>
</head>
<body>
  <div class="register-box shadow-lg floating">
    <h2>Create Your Account</h2>

    <% if (error) { %>
      <div class="alert alert-danger text-center mb-3"><%= error %></div>
    <% } %>

    <form action="/register" method="POST" novalidate>
      <div class="mb-3">
        <input type="text" name="name" class="form-control" placeholder="Name" required autocomplete="name">
      </div>
      <div class="mb-3">
        <input type="email" name="email" class="form-control" placeholder="Email" required autocomplete="email">
      </div>
      <div class="mb-3">
        <input type="password" name="password" class="form-control" placeholder="Password" required autocomplete="new-password">
      </div>
      <div class="d-grid mb-2">
        <button type="submit" class="btn btn-glow">Register</button>
      </div>
    </form>

    <p class="text-center text-small text-light mb-2">or</p>

    <div class="d-grid">
      <a href="/auth/google" class="btn btn-google">
        <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" class="google-icon">
        Register with Google
      </a>
    </div>

    <p class="text-center mt-3 text-small text-light">
      Already have an account?
      <a href="/login" class="link-glow">Login</a>
    </p>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
