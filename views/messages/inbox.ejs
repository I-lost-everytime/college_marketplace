<%- include("../partials/header", { user }) %>

<style>
  .chat-list {
    max-width: 600px;
    margin: auto;
  }

  .chat-user {
    background-color: #1e1e1e;
    color: #eee;
    padding: 15px 20px;
    margin-bottom: 10px;
    border-radius: 10px;
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.3s ease;
  }

  .chat-user:hover {
    background-color: #333;
  }

  .chat-user-left {
    display: flex;
    flex-direction: column;
  }

  .chat-user h5 {
    margin: 0;
    font-size: 1.1rem;
  }

  .chat-user small {
    color: #aaa;
  }

  .unread-badge {
    background-color: #e74c3c;
    color: white;
    border-radius: 50%;
    padding: 4px 9px;
    font-size: 0.75rem;
    font-weight: bold;
    min-width: 22px;
    text-align: center;
  }

  .last-message {
    color: #bbb;
    font-size: 0.9rem;
    margin-top: 3px;
    max-width: 300px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<div class="container mt-4 chat-list">
  <h3 class="mb-4 text-center">📨 Messages</h3>

  <% if (users.length === 0) { %>
    <p class="text-center text-muted">No conversations yet.</p>
  <% } %>

  <% users.forEach(u => { %>
    <a href="/messages/<%= u.user_id %>" class="chat-user">
      <div class="chat-user-left">
        <h5><%= u.name %></h5>
        <div class="last-message"><%= u.last_message || "No messages yet." %></div>
      </div>
      <div>
        <% if (u.unread_count > 0) { %>
          <span class="unread-badge"><%= u.unread_count %></span>
        <% } %>
      </div>
    </a>
  <% }) %>
</div>

<%- include("../partials/footer") %>
