<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile - <%= user.name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Inter', sans-serif; }
    
    /* Custom dark theme enhancements */

    @keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-fade-in {
  animation: fadeIn 0.6s ease forwards;
}
    .dark-glass {
      backdrop-filter: blur(20px);
      background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .dark-card {
      background: linear-gradient(145deg, rgba(15, 15, 15, 0.9), rgba(30, 30, 30, 0.7));
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .glow-hover:hover {
      box-shadow: 0 20px 40px rgba(139, 92, 246, 0.3);
      transform: translateY(-5px);
    }
    
    .text-shimmer {
      background: linear-gradient(45deg, #8b5cf6, #a855f7, #d946ef, #ec4899, #8b5cf6);
      background-size: 300% 300%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: shimmer 3s ease infinite;
    }
    
    @keyframes shimmer {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    
    .profile-glow {
      box-shadow: 0 0 30px rgba(139, 92, 246, 0.4), 0 0 60px rgba(139, 92, 246, 0.2);
    }
    
    .card-lift:hover {
      transform: translateY(-8px) scale(1.02);
    }
  </style>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          animation: {
            'fade-in': 'fadeIn 0.8s ease-in-out',
            'slide-up': 'slideUp 0.6s ease-out',
            'pulse-slow': 'pulse 3s infinite',
            'float': 'float 6s ease-in-out infinite',
            'glow': 'glow 2s ease-in-out infinite alternate'
          },
          keyframes: {
            fadeIn: {
              '0%': { opacity: '0', transform: 'translateY(30px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' }
            },
            slideUp: {
              '0%': { opacity: '0', transform: 'translateY(50px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' }
            },
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-10px)' }
            },
            glow: {
              '0%': { boxShadow: '0 0 20px rgba(139, 92, 246, 0.4)' },
              '100%': { boxShadow: '0 0 40px rgba(139, 92, 246, 0.8)' }
            }
          }
        }
      }
    }
  </script>
</head>
<body class="min-h-screen bg-black text-white relative overflow-x-hidden">
  
  <!-- Animated background elements -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-20 left-10 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-pink-500/5 rounded-full blur-3xl animate-pulse" style="animation-delay: 4s;"></div>
  </div>
  
  <!-- Ultra Modern Dark Navbar -->
  <nav class="dark-glass fixed top-0 w-full z-50 border-b border-gray-800/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Enhanced Brand -->
        <div class="flex items-center space-x-4">
          <div class="relative">
            <div class="w-12 h-12 bg-gradient-to-br from-purple-500 via-blue-500 to-pink-500 rounded-2xl flex items-center justify-center profile-glow animate-float">
              <i class="fas fa-user text-white text-lg"></i>
            </div>
            <div class="absolute -top-1 -right-1 w-4 h-4 bg-gradient-to-r from-green-400 to-emerald-400 rounded-full border-2 border-black animate-glow"></div>
          </div>
          <div>
            <span class="text-2xl font-bold text-shimmer">
              <%= user.name %>
            </span>
            <div class="text-xs text-gray-500 font-medium">Profile Dashboard</div>
          </div>
        </div>
        
        <!-- Enhanced Navigation -->
        <div class="flex items-center space-x-4">
          <a href="/menu" 
             class="flex items-center space-x-2 px-6 py-3 dark-glass rounded-2xl hover:bg-white/10 transition-all duration-300 glow-hover">
            <i class="fas fa-tachometer-alt text-purple-400"></i>
            <span class="hidden sm:inline font-medium">Menu</span>
          </a>
          <a href="/books/add" 
             class="flex items-center space-x-2 px-6 py-3 bg-gradient-to-r from-purple-600 via-blue-600 to-purple-600 rounded-2xl hover:from-purple-500 hover:via-blue-500 hover:to-purple-500 transition-all duration-300 glow-hover shadow-2xl">
            <i class="fas fa-plus"></i>
            <span class="hidden sm:inline font-semibold">Add Book</span>
          </a>
          <a href="/logout" 
             class="flex items-center space-x-2 px-6 py-3 dark-glass border border-red-500/30 text-red-400 hover:bg-red-500/10 hover:border-red-400 rounded-2xl transition-all duration-300">
            <i class="fas fa-sign-out-alt"></i>
            <span class="hidden sm:inline font-medium">Logout</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 mt-20 relative z-10">
    
    <!-- Epic Profile Header -->
    <div class="dark-card rounded-3xl p-10 mb-10 shadow-2xl animate-fade-in profile-glow relative overflow-hidden">
      <!-- Subtle grid pattern overlay -->
      <div class="absolute inset-0 opacity-5">
        <svg class="w-full h-full" viewBox="0 0 100 100">
          <defs>
            <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
              <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"/>
            </pattern>
          </defs>
          <rect width="100" height="100" fill="url(#grid)" />
        </svg>
      </div>
      
      <div class="relative z-10 flex flex-col lg:flex-row items-center lg:items-start space-y-8 lg:space-y-0 lg:space-x-12">
        
        <!-- Enhanced Profile Image -->
        <div class="relative group">
          <% 
            const fallbackImgs = [
              'https://i.pravatar.cc/250?img=1',
              'https://i.pravatar.cc/250?img=2',
              'https://i.pravatar.cc/250?img=3',
              'https://i.pravatar.cc/250?img=4',
              'https://i.pravatar.cc/250?img=5'
            ];
            let profilePic = user.photo ? (user.photo + '?sz=250') : fallbackImgs[Math.floor(Math.random() * fallbackImgs.length)];
          %>
          
          <!-- Rotating border animation -->
          <div class="absolute -inset-4 bg-gradient-to-r from-purple-500 via-blue-500 to-pink-500 rounded-full opacity-75 animate-spin" style="animation-duration: 8s;"></div>
          
          <div class="relative w-44 h-44 lg:w-52 lg:h-52">
            <div class="w-full h-full bg-gradient-to-br from-purple-500 via-blue-500 to-pink-500 rounded-full p-2 shadow-2xl">
              <img src="<%= profilePic %>" 
                   alt="Profile Picture" 
                   class="w-full h-full rounded-full object-cover border-4 border-black group-hover:scale-105 transition-transform duration-500"
                   onerror="this.onerror=null;this.src='https://via.placeholder.com/250/8B5CF6/FFFFFF?text=<%= user.name.charAt(0) %>';">
            </div>
            
            <!-- Status indicator -->
            <div class="absolute -bottom-2 -right-2 w-12 h-12 bg-gradient-to-br from-green-400 to-emerald-400 rounded-full border-4 border-black flex items-center justify-center animate-glow">
              <i class="fas fa-check text-white text-lg"></i>
            </div>
            
            <!-- Floating status badges -->
            <div class="absolute -top-4 -left-4 px-4 py-2 dark-glass rounded-full text-xs font-bold text-purple-300 border border-purple-500/30 animate-float">
              <i class="fas fa-star mr-1"></i>Pro
            </div>
            <div class="absolute -top-4 -right-4 px-4 py-2 dark-glass rounded-full text-xs font-bold text-blue-300 border border-blue-500/30 animate-float" style="animation-delay: 1s;">
              <i class="fas fa-shield-check mr-1"></i>Verified
            </div>
          </div>
        </div>

        <!-- Enhanced Profile Info -->
        <div class="flex-1 text-center lg:text-left space-y-6">
          <div>
            <h1 class="text-5xl lg:text-6xl font-black mb-4 text-shimmer leading-tight">
              <%= user.name %>
            </h1>
            <p class="text-xl text-gray-400 font-light">Digital Marketplace Creator</p>
          </div>
          
          <div class="space-y-4">
            <div class="flex items-center justify-center lg:justify-start space-x-4 text-gray-300 group">
              <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-blue-500 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform shadow-lg">
                <i class="fas fa-envelope text-white"></i>
              </div>
              <span class="text-lg font-medium"><%= user.email %></span>
            </div>
            
            <% if (user.college) { %>
              <div class="flex items-center justify-center lg:justify-start space-x-4 text-gray-300 group">
                <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-500 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform shadow-lg">
                  <i class="fas fa-graduation-cap text-white"></i>
                </div>
                <span class="text-lg font-medium"><%= user.college %></span>
              </div>
            <% } %>
          </div>

          <!-- Enhanced Badges -->
          <div class="flex flex-wrap justify-center lg:justify-start gap-4">
            <div class="px-6 py-3 dark-glass rounded-2xl border border-purple-500/30 text-purple-300 font-semibold flex items-center space-x-3 card-lift cursor-default">
              <i class="fas fa-calendar-alt text-purple-400"></i>
              <span>Joined <%= new Date(user.createdAt || Date.now()).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %></span>
            </div>
            <div class="px-6 py-3 dark-glass rounded-2xl border border-green-500/30 text-green-300 font-semibold flex items-center space-x-3 card-lift cursor-default">
              <i class="fas fa-check-circle text-green-400"></i>
              <span>Verified</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Enhanced Stats Section -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 animate-slide-up">
      <div class="dark-card rounded-3xl p-8 border border-purple-500/20 hover:border-purple-500/40 transition-all duration-500 card-lift glow-hover group relative overflow-hidden shadow-2xl">
        <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-purple-600/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 flex items-center space-x-6">
          <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-700 rounded-3xl flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform duration-300">
            <i class="fas fa-book text-white text-xl"></i>
          </div>
          <div>
            <div class="text-4xl font-black text-white mb-1"><%= listedBooks.length %></div>
            <div class="text-gray-400 font-semibold">Listed Books</div>
          </div>
        </div>
      </div>

      <div class="dark-card rounded-3xl p-8 border border-blue-500/20 hover:border-blue-500/40 transition-all duration-500 card-lift glow-hover group relative overflow-hidden shadow-2xl">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-blue-600/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 flex items-center space-x-6">
          <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-700 rounded-3xl flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform duration-300">
            <i class="fas fa-eye text-white text-xl"></i>
          </div>
          <div>
            <div class="text-4xl font-black text-white mb-1">
              <% const totalViews = listedBooks.reduce((sum, book) => sum + (book.views || 0), 0); %>
              <%= totalViews || 0 %>
            </div>
            <div class="text-gray-400 font-semibold">Total Views</div>
          </div>
        </div>
      </div>

      <div class="dark-card rounded-3xl p-8 border border-green-500/20 hover:border-green-500/40 transition-all duration-500 card-lift glow-hover group relative overflow-hidden shadow-2xl">
        <div class="absolute inset-0 bg-gradient-to-br from-green-500/5 to-green-600/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 flex items-center space-x-6">
          <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-700 rounded-3xl flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform duration-300">
            <i class="fas fa-rupee-sign text-white text-xl"></i>
          </div>
          <div>
            <div class="text-4xl font-black text-white mb-1">
              <% const avgPrice = listedBooks.length > 0 ? Math.round(listedBooks.reduce((sum, book) => sum + parseFloat(book.price), 0) / listedBooks.length) : 0; %>
              ₹<%= avgPrice %>
            </div>
            <div class="text-gray-400 font-semibold">Avg. Price</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Enhanced Books Section -->
    <div class="dark-card rounded-3xl border border-gray-800/50 animate-fade-in overflow-hidden shadow-2xl">
      
      <!-- Section Header -->
      <div class="relative p-10 border-b border-gray-800/50">
        <div class="absolute inset-0 bg-gradient-to-r from-purple-500/5 via-blue-500/5 to-purple-500/5"></div>
        <div class="relative z-10 flex items-center justify-between">
          <div class="flex items-center space-x-6">
            <div class="w-16 h-16 bg-gradient-to-br from-purple-500 via-blue-500 to-purple-500 rounded-3xl flex items-center justify-center shadow-2xl animate-float">
              <i class="fas fa-books text-white text-xl"></i>
            </div>
            <div>
              <h2 class="text-3xl font-black text-white text-shimmer">Your Listed Books</h2>
              <p class="text-gray-400 text-lg"><%= listedBooks.length %> books in your collection</p>
            </div>
          </div>
          
          <% if (listedBooks.length > 0) { %>
            <a href="/books/add" 
               class="px-8 py-4 bg-gradient-to-r from-purple-500 to-blue-500 rounded-2xl hover:from-purple-400 hover:to-blue-400 transition-all duration-300 card-lift shadow-2xl flex items-center space-x-3 font-semibold">
              <i class="fas fa-plus"></i>
              <span>Add More</span>
            </a>
          <% } %>
        </div>
      </div>

      <!-- Books Content -->
      <div class="p-10">
        <% if (listedBooks.length === 0) { %>
          <!-- Enhanced Empty State -->
          <div class="text-center py-20">
            <div class="relative mb-12">
              <div class="w-32 h-32 bg-gradient-to-br from-purple-500/20 via-blue-500/20 to-purple-500/20 rounded-full flex items-center justify-center mx-auto shadow-2xl animate-float">
                <i class="fas fa-book-open text-6xl text-shimmer"></i>
              </div>
              <div class="absolute -top-2 -right-4 w-8 h-8 bg-gradient-to-r from-yellow-400 to-orange-400 rounded-full flex items-center justify-center animate-bounce">
                <i class="fas fa-sparkles text-white text-xs"></i>
              </div>
            </div>
            <h3 class="text-4xl font-black text-shimmer mb-6">No books listed yet</h3>
            <p class="text-xl text-gray-300 mb-12 max-w-2xl mx-auto leading-relaxed">Start building your marketplace presence by adding your first book and connect with potential buyers!</p>
            <a href="/books/add" 
               class="inline-flex items-center space-x-4 px-12 py-6 bg-gradient-to-r from-purple-500 to-blue-500 rounded-3xl hover:from-purple-400 hover:to-blue-400 transition-all duration-500 card-lift shadow-2xl text-xl font-bold">
              <i class="fas fa-plus text-2xl"></i>
              <span>Add Your First Book</span>
            </a>
          </div>
        <% } else { %>
          <!-- Enhanced Books Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
            <% listedBooks.forEach((book, index) => { %>
              <div class="group bg-gray-900 rounded-3xl border border-gray-800/50 
            hover:border-purple-500/30 transition-all duration-500 
            hover:-translate-y-2 hover:scale-[1.02] 
            hover:shadow-[0_0_20px_rgba(168,85,247,0.6)] 
            overflow-hidden opacity-0 animate-fade-in shadow-2xl"
                    >

                
                <!-- Enhanced Book Image -->
                <div class="relative overflow-hidden">
                  <% if (book.image_url) { %>
                    <img src="<%= book.image_url %>" 
                         alt="<%= book.title %>" 
                         class="w-full h-56 object-cover group-hover:scale-110 transition-transform duration-700">
                  <% } else { %>
                    <div class="w-full h-56 bg-gradient-to-br from-gray-800 via-gray-700 to-gray-600 flex items-center justify-center">
                      <i class="fas fa-book text-5xl text-gray-400"></i>
                    </div>
                  <% } %>
                  
                  <!-- Status Badge -->
                  <div class="absolute top-4 right-4">
                    <span class="px-4 py-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-2xl text-white text-sm font-bold shadow-lg">
                      <i class="fas fa-check-circle mr-1"></i>Active
                    </span>
                  </div>
                  
                  <!-- Views Badge -->
                  <div class="absolute bottom-4 left-4">
                    <span class="px-4 py-2 dark-glass rounded-2xl text-white text-sm font-medium flex items-center space-x-2 border border-white/10">
                      <i class="fas fa-eye text-blue-400"></i>
                      <span><%= book.views || 0 %></span>
                    </span>
                  </div>
                </div>

                <!-- Enhanced Book Details -->
                <div class="p-8">
                  <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-purple-300 transition-colors duration-300 line-clamp-1">
                    <%= book.title %>
                  </h3>
                  
                  <div class="flex items-center text-gray-400 text-sm mb-4">
                    <div class="w-6 h-6 bg-gradient-to-r from-purple-500 to-blue-500 rounded-lg flex items-center justify-center mr-3">
                      <i class="fas fa-user text-white text-xs"></i>
                    </div>
                    <span class="font-medium">by <%= book.author || book.extraInfo || 'Unknown' %></span>
                  </div>
                  
                  <p class="text-gray-300 text-sm mb-6 line-clamp-2 leading-relaxed">
                    <%= book.description || 'No description available' %>
                  </p>

                  <!-- Price Display -->
                  <div class="mb-8">
                    <span class="text-3xl font-black bg-gradient-to-r from-green-400 to-emerald-400 bg-clip-text text-transparent">
                      ₹<%= book.price %>
                    </span>
                    <% if (book.rent_per_day && book.rent_per_day > 0) { %>
                      <span class="text-sm text-gray-400 ml-2">or ₹<%= book.rent_per_day %>/day</span>
                    <% } %>
                  </div>

                  <!-- Action Buttons -->
                  <div class="flex items-center space-x-3">
                    <a href="/books/edit/<%= book.id %>" 
                       class="flex-1 py-3 px-4 dark-glass border border-yellow-500/30 hover:border-yellow-400/50 rounded-2xl text-yellow-400 text-center transition-all duration-300 hover:bg-yellow-500/10 flex items-center justify-center space-x-2 font-semibold card-lift">
                      <i class="fas fa-edit"></i>
                      <span class="text-sm">Edit</span>
                    </a>
                    
                    <button onclick="copyBookLink('<%= book.id %>')" 
                            class="py-3 px-4 dark-glass border border-blue-500/30 hover:border-blue-400/50 rounded-2xl text-blue-400 transition-all duration-300 hover:bg-blue-500/10 card-lift">
                      <i class="fas fa-share"></i>
                    </button>
                    
                    <form action="/books/delete/<%= book.id %>" method="POST" class="inline" 
                          onsubmit="return confirm('Are you sure you want to delete this book?')">
                      <button type="submit" 
                              class="py-3 px-4 dark-glass border border-red-500/30 hover:border-red-400/50 rounded-2xl text-red-400 transition-all duration-300 hover:bg-red-500/10 card-lift">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <!-- Enhanced Toast Notification -->
  <div id="toast" class="fixed bottom-8 right-8 transform translate-x-full transition-transform duration-500 ease-in-out z-50">
    <div class="dark-card px-8 py-4 rounded-2xl shadow-2xl flex items-center space-x-4 border border-green-500/30">
      <div class="w-8 h-8 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full flex items-center justify-center">
        <i class="fas fa-check text-white text-sm"></i>
      </div>
      <span class="font-semibold text-white">Book link copied to clipboard!</span>
    </div>
  </div>

  <script>
    // Copy book link functionality
    function copyBookLink(bookId) {
      const url = window.location.origin + '/books/' + bookId;
      
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(() => {
          showToast();
        }).catch(err => {
          console.error('Failed to copy: ', err);
          fallbackCopy(url);
        });
      } else {
        fallbackCopy(url);
      }
    }

    function fallbackCopy(text) {
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-999999px';
      textArea.style.top = '-999999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      
      try {
        document.execCommand('copy');
        showToast();
      } catch (err) {
        console.error('Fallback copy failed: ', err);
      }
      
      document.body.removeChild(textArea);
    }

    function showToast() {
      const toast = document.getElementById('toast');
      toast.classList.remove('translate-x-full');
      
      setTimeout(() => {
        toast.classList.add('translate-x-full');
      }, 3500);
    }

    // Enhanced scroll animations
    function animateOnScroll() {
      const elements = document.querySelectorAll('[class*="animate-"]');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.style.animationPlayState = 'running';
          }
        });
      }, { threshold: 0.1 });

      elements.forEach(el => {
        el.style.animationPlayState = 'paused';
        observer.observe(el);
      });
    }

    // Initialize enhanced interactions
    document.addEventListener('DOMContentLoaded', () => {
      animateOnScroll();
      
      // Staggered animation for book cards
      const bookCards = document.querySelectorAll('.grid > div[style*="animation-delay"]');
      bookCards.forEach((card, index) => {
        card.style.animationDelay = `${index * 0.1}s`;
        card.classList.add('animate-fade-in');
      });
      
      // Add subtle parallax to background elements
      window.addEventListener('scroll', () => {
        const scrolled = window.pageYOffset;
        const parallaxElements = document.querySelectorAll('[class*="animate-pulse"]');
        
        parallaxElements.forEach((element, index) => {
          const speed = 0.1 + (index * 0.02);
          element.style.transform = `translateY(${scrolled * speed}px)`;
        });
      });
      
      // Add hover effects to interactive elements
      const interactiveElements = document.querySelectorAll('a, button');
      interactiveElements.forEach(element => {
        element.addEventListener('mouseenter', () => {
          element.style.transform = 'translateY(-2px)';
        });
        
        element.addEventListener('mouseleave', () => {
          element.style.transform = 'translateY(0)';
        });
      });
    });
  </script>
</body>
</html>