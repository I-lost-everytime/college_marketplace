<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Marketplace - College Marketplace</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'dark-bg': '#0d1117',
            'card-bg': '#161b22',
            'border-color': '#30363d',
            'text-primary': '#e6edf3',
            'text-secondary': '#7d8590',
            'accent-blue': '#58a6ff',
            'accent-purple': '#a855f7',
            'accent-green': '#3fb950',
            'accent-pink': '#f85149',
            'accent-yellow': '#d29922',
            'accent-cyan': '#39d353'
          },
          animation: {
            'fade-in': 'fadeIn 0.5s ease-in-out',
            'slide-up': 'slideUp 0.5s ease-out',
            'glow': 'glow 2s ease-in-out infinite alternate'
          }
        }
      }
    }
  </script>
  <style>
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideUp {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    @keyframes glow {
      from { box-shadow: 0 0 20px rgba(88, 166, 255, 0.3); }
      to { box-shadow: 0 0 30px rgba(88, 166, 255, 0.6); }
    }
    
    /* Animation delay using CSS custom properties */
    .item-card {
      animation-delay: var(--delay, 0ms);
    }
  </style>
</head>

<body class="bg-dark-bg text-text-primary min-h-screen">
  <!-- Header -->
  <header class="bg-black/80 backdrop-blur-md border-b border-border-color sticky top-0 z-50">
    <div class="container mx-auto px-4 py-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <h1 class="text-xl sm:text-2xl font-bold bg-gradient-to-r from-accent-blue to-accent-purple bg-clip-text text-transparent">
          Welcome, <%= user.name %>! 👋
        </h1>
        <div class="flex gap-2">
          <button onclick="window.location.href='/messages'" 
                  class="flex-1 sm:flex-none px-4 py-2 bg-card-bg hover:bg-accent-blue/20 border border-border-color hover:border-accent-blue rounded-lg transition-all duration-300 text-sm font-medium">
            💬 Messages
          </button>
          <button onclick="window.location.href='/profile'" 
                  class="flex-1 sm:flex-none px-4 py-2 bg-card-bg hover:bg-accent-purple/20 border border-border-color hover:border-accent-purple rounded-lg transition-all duration-300 text-sm font-medium">
            👤 Profile
          </button>
        </div>
      </div>
    </div>
  </header>

  <main class="container mx-auto px-4 py-6">
    <!-- Search Section -->
    <section class="mb-8">
      <form method="GET" action="/menu" class="max-w-2xl mx-auto">
        <div class="relative">
          <input type="text" 
                 name="search" 
                 class="w-full px-6 py-4 bg-card-bg border border-border-color rounded-2xl focus:border-accent-blue focus:ring-2 focus:ring-accent-blue/30 focus:outline-none transition-all duration-300 text-lg placeholder-text-secondary pr-16"
                 placeholder="Search items, books, electronics..." 
                 value="<%= search || '' %>">
          <button type="submit" 
                  class="absolute right-2 top-1/2 transform -translate-y-1/2 px-6 py-2 bg-gradient-to-r from-accent-blue to-accent-purple rounded-xl hover:shadow-lg transition-all duration-300 font-medium">
            🔍 Search
          </button>
        </div>
      </form>
    </section>

    <!-- Category Filters -->
    <section class="mb-8">
      <div class="flex flex-wrap gap-2 justify-center">
        <button onclick="filterCategory('all')" 
                class="category-btn <%= (!category || category === 'all') ? 'active' : '' %> px-4 py-2 rounded-full border transition-all duration-300 text-sm font-medium">
          🏠 All Items
        </button>
        <button onclick="filterCategory('Books')" 
                class="category-btn <%= category === 'books' ? 'active' : '' %> px-4 py-2 rounded-full border transition-all duration-300 text-sm font-medium">
          📚 Books
        </button>
        <button onclick="filterCategory('drg_assignments')" 
                class="category-btn <%= category === 'drg_assignments' ? 'active' : '' %> px-4 py-2 rounded-full border transition-all duration-300 text-sm font-medium">
          📝 Assignments
        </button>
        <button onclick="filterCategory('thrifting')" 
                class="category-btn <%= category === 'thrifting' ? 'active' : '' %> px-4 py-2 rounded-full border transition-all duration-300 text-sm font-medium">
          👕 Thrifting
        </button>
        <button onclick="filterCategory('electronics')" 
                class="category-btn <%= category === 'electronics' ? 'active' : '' %> px-4 py-2 rounded-full border transition-all duration-300 text-sm font-medium">
          💻 Electronics
        </button>
        <button onclick="filterCategory('artworks')" 
                class="category-btn <%= category === 'artworks' ? 'active' : '' %> px-4 py-2 rounded-full border transition-all duration-300 text-sm font-medium">
          🎨 Artworks
        </button>
        <button onclick="filterCategory('other')" 
                class="category-btn <%= category === 'other' ? 'active' : '' %> px-4 py-2 rounded-full border transition-all duration-300 text-sm font-medium">
          🔧 Other
        </button>
      </div>
    </section>

    <!-- Items Grid -->
    <section>
      <% if (books && books.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          <% const glowColors = ['border-accent-blue', 'border-accent-purple', 'border-accent-green', 'border-accent-pink', 'border-accent-yellow', 'border-accent-cyan']; %>
          <% books.forEach((book, index) => { %>
            <div class="item-card bg-card-bg border border-border-color rounded-2xl overflow-hidden hover:border-accent-blue hover:shadow-xl hover:shadow-accent-blue/20 transition-all duration-300 group animate-slide-up delay-<%= (index % 12) * 100 %>">
              
              <!-- Image Section -->
              <div class="aspect-video bg-gradient-to-br from-gray-800 to-gray-900 relative overflow-hidden">
                <% if (book.image_url) { %>
                  <img src="<%= book.image_url %>" 
                       class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                       alt="<%= book.title %>">
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-text-secondary text-4xl">
                    📦
                  </div>
                <% } %>
                
                <!-- Price Badge -->
                <div class="absolute top-3 right-3 bg-accent-green/90 backdrop-blur-sm px-3 py-1 rounded-full text-white font-bold text-sm">
                  ₹<%= book.price %>
                </div>
              </div>

              <!-- Content Section -->
              <div class="p-4 flex flex-col h-64">
                <h3 class="font-bold text-lg line-clamp-2 mb-2 group-hover:text-accent-blue transition-colors duration-300">
                  <%= book.title %>
                </h3>
                
                <% if (book.author) { %>
                  <p class="text-text-secondary text-sm mb-2">by <%= book.author %></p>
                <% } %>
                
                <% if (book.brand) { %>
                  <p class="text-text-secondary text-sm mb-1">
                    <span class="font-medium">Brand:</span> <%= book.brand %>
                  </p>
                <% } %>
                
                <% if (book.size) { %>
                  <p class="text-text-secondary text-sm mb-1">
                    <span class="font-medium">Size:</span> <%= book.size %>
                  </p>
                <% } %>
                
                <% if (book.art_by) { %>
                  <p class="text-text-secondary text-sm mb-1">
                    <span class="font-medium">Art by:</span> <%= book.art_by %>
                  </p>
                <% } %>
                
                <p class="text-text-secondary text-sm line-clamp-3 mb-3 flex-grow">
                  <%= book.description %>
                </p>
                
                <!-- Tags -->
                <% if (book.tags && Array.isArray(book.tags) && book.tags.length > 0) { %>
                  <div class="flex flex-wrap gap-1 mb-3">
                    <% book.tags.slice(0, 3).forEach(tag => { %>
                      <span class="px-2 py-1 bg-accent-blue/20 text-accent-blue text-xs rounded-full">
                        <%= tag %>
                      </span>
                    <% }) %>
                  </div>
                <% } %>
                
                <!-- Seller & Category Info -->
                <div class="flex justify-between items-center text-xs text-text-secondary mb-3">
                  <span>👤 <%= book.seller %></span>
                  <span class="px-2 py-1 bg-gray-700 rounded">
                    <%= book.category || 'Books' %>
                  </span>
                </div>
                
                <!-- Rent Info -->
                <% if (book.rent_per_day) { %>
                  <p class="text-accent-cyan text-sm font-medium mb-3">
                    🏠 Rent: ₹<%= book.rent_per_day %>/day
                  </p>
                <% } %>

                <!-- Action Buttons -->
                <div class="mt-auto">
                  <% if (book.user_id === user.id) { %>
                    <div class="flex gap-2">
                      <a href="/books/edit/<%= book.id %>" 
                         class="flex-1 px-3 py-2 bg-accent-yellow/20 hover:bg-accent-yellow/30 text-accent-yellow border border-accent-yellow/50 rounded-lg text-center text-sm font-medium transition-all duration-300">
                        ✏️ Edit
                      </a>
                      <form action="/books/delete/<%= book.id %>" method="POST" 
                            onsubmit="return confirm('Are you sure?')" 
                            class="flex-1">
                        <button class="w-full px-3 py-2 bg-accent-pink/20 hover:bg-accent-pink/30 text-accent-pink border border-accent-pink/50 rounded-lg text-sm font-medium transition-all duration-300">
                          🗑️ Delete
                        </button>
                      </form>
                    </div>
                  <% } else { %>
                    <a href="/messages/<%= book.user_id %>" 
                       class="block w-full px-4 py-3 bg-gradient-to-r from-accent-blue to-accent-purple hover:from-accent-purple hover:to-accent-blue rounded-lg text-center font-medium transition-all duration-300 hover:shadow-lg">
                      💬 Message Seller
                    </a>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-16">
          <div class="text-6xl mb-4">📦</div>
          <h3 class="text-xl font-semibold mb-2">No items found</h3>
          <p class="text-text-secondary">Try adjusting your search terms or category filters</p>
        </div>
      <% } %>
    </section>
  </main>

  <!-- Floating Add Button -->
  <button 
    onclick="window.location.href='/books/add'" 
    class="fixed bottom-6 right-6 w-14 h-14 bg-gradient-to-r from-accent-blue to-accent-purple rounded-full shadow-lg hover:shadow-xl transition-all duration-300 flex items-center justify-center text-2xl hover:scale-110 z-40">
    ➕
</button>

  <script>
    function filterCategory(category) {
      const currentUrl = new URL(window.location);
      
      if (category === 'all') {
        currentUrl.searchParams.delete('category');
      } else {
        currentUrl.searchParams.set('category', category);
      }
      
      const searchParam = currentUrl.searchParams.get('search');
      if (searchParam) {
        currentUrl.searchParams.set('search', searchParam);
      }
      
      window.location.href = currentUrl.toString();
    }

    // Enhanced category button styling
    document.addEventListener('DOMContentLoaded', function() {
      const categoryButtons = document.querySelectorAll('.category-btn');
      
      categoryButtons.forEach(btn => {
        if (btn.classList.contains('active')) {
          btn.className = 'category-btn active px-4 py-2 rounded-full border bg-accent-blue border-accent-blue text-white transition-all duration-300 text-sm font-medium';
        } else {
          btn.className = 'category-btn px-4 py-2 rounded-full border bg-card-bg border-border-color hover:border-accent-blue hover:bg-accent-blue/10 transition-all duration-300 text-sm font-medium';
        }
      });
    });

    // Add smooth scrolling behavior
    document.documentElement.style.scrollBehavior = 'smooth';

    // Add intersection observer for fade-in animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.item-card').forEach(card => {
      observer.observe(card);
    });
  </script>
</body>
</html>
