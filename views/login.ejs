<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login - Book Marketplace</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom Glow Styling -->
  <style>
    body {
      background: radial-gradient(circle at top left, #0d1117, #0a0a0a);
      color: #e6f1ff;
      font-family: 'Segoe UI', sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1rem;
    }

    .login-box {
      background-color: #1a1a2e;
      padding: 2.5rem;
      border-radius: 20px;
      max-width: 420px;
      width: 100%;
      box-shadow: 0 0 25px rgba(0, 229, 255, 0.1);
      border: 2px solid transparent;
      transition: 0.4s ease;
    }

    .login-box:hover {
      box-shadow: 0 0 35px #00e5ff88;
      border-color: #00e5ff;
      transform: scale(1.01);
    }

    .login-box h2 {
      color: #00e5ff;
      text-shadow: 0 0 10px #00e5ff88;
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .form-control {
      background-color: #2c2f3a;
      border: 1px solid #444;
      color: #e6f1ff;
      transition: 0.3s;
    }

    .form-control:focus {
      border-color: #00e5ff;
      box-shadow: 0 0 10px rgba(0, 229, 255, 0.5);
      background-color: #2c2f3a;
      color: #fff;
    }

    .form-control::placeholder {
      color: #aaa;
    }

    .btn-glow {
      background: linear-gradient(45deg, #00e5ff, #00bfff);
      color: #000;
      font-weight: 600;
      border: none;
      border-radius: 10px;
      padding: 0.6rem;
      transition: all 0.3s ease;
      box-shadow: 0 0 10px rgba(0, 229, 255, 0.4);
    }

    .btn-glow:hover {
      background: linear-gradient(45deg, #00c4cc, #00aaff);
      box-shadow: 0 0 18px rgba(0, 229, 255, 0.7);
      transform: scale(1.03);
    }

    .text-small {
      font-size: 0.9rem;
    }

    .link-glow {
      color: #00e5ff;
      transition: 0.2s ease;
    }

    .link-glow:hover {
      color: #80faff;
      text-decoration: underline;
    }

    .alert-danger {
      background-color: #ff4c4c;
      color: #fff;
      border: none;
      box-shadow: 0 0 12px rgba(255, 76, 76, 0.5);
    }

    .floating {
      animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
    }
  </style>
</head>
<body>
  <div class="login-box shadow-lg floating">
    <h2>Login to Marketplace</h2>

    <% if (error) { %>
      <div class="alert alert-danger text-center"><%= error %></div>
    <% } %>

    <!-- Regular Login Form -->
    <form action="/login" method="POST" novalidate>
      <div class="mb-3">
        <input type="email" name="email" class="form-control" placeholder="Email" required autocomplete="email">
      </div>
      <div class="mb-3">
        <input type="password" name="password" class="form-control" placeholder="Password" required autocomplete="current-password">
      </div>
      <div class="d-grid">
        <button type="submit" class="btn btn-glow">Login</button>
      </div>
    </form>

    <!-- Divider -->
    <div class="text-center my-3 text-light">
      <hr style="border-color: #00e5ff; opacity: 0.3;">
      <span style="background: #1a1a2e; padding: 0 12px; color: #00e5ff;">OR</span>
    </div>

    <!-- Google Login -->
    <div class="d-grid mb-3">
      <a href="/auth/google" class="btn btn-danger d-flex align-items-center justify-content-center gap-2">
        <img src="https://img.icons8.com/color/24/000000/google-logo.png" alt="Google Logo" style="width: 20px;">
        Sign in with Google (@nith.ac.in)
      </a>
    </div>

    <!-- Register Link -->
    <p class="text-center mt-3 text-small text-light">
      Don't have an account?
      <a href="/register" class="link-glow">Register</a>
    </p>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootst
